[Unit]
Description=Matter temperature and humidity sensor (SG2002 RTC information backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matter-sensor
Group=matter-sensor
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO
StateDirectory=matter-temperature-humidity-sensor
WorkingDirectory=/var/lib/matter-temperature-humidity-sensor
ExecStartPre=+/usr/local/libexec/matter-sensor-sg2002/prepare-gpios.sh --configure-led-gpio
ExecStartPre=+/usr/local/libexec/matter-sensor-sg2002/8051_up /usr/local/lib/matter-sensor-sg2002/mars_mcu_fw.bin
ExecStart=/usr/local/bin/matter-temperature-humidity-sensor --sensor-config /etc/matter-temperature-humidity-sensor.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
